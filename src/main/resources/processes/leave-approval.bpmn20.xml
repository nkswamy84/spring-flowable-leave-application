<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://example.com/leave">

  <process id="leaveApproval" name="Leave Approval" isExecutable="true">
    <startEvent id="start" name="Leave submitted" />

    <userTask id="managerApproval" name="Manager approval" flowable:candidateGroups="managers" />

    <exclusiveGateway id="approvalGateway" />

    <sequenceFlow id="flow_start_to_task" sourceRef="start" targetRef="managerApproval" />
    <sequenceFlow id="flow_task_to_gateway" sourceRef="managerApproval" targetRef="approvalGateway" />

    <sequenceFlow id="flow_approved" sourceRef="approvalGateway" targetRef="approvedEnd">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="flow_rejected" sourceRef="approvalGateway" targetRef="rejectedEnd">
      <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
    </sequenceFlow>

    <endEvent id="approvedEnd" name="Approved" />
    <endEvent id="rejectedEnd" name="Rejected" />
  </process>
</definitions>
